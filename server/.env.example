PORT=3001

# --- AI syllabus reader (optional but recommended) ---
# With a key set, uploaded syllabi are parsed by Claude (clean dates, titles, and
# assignment-vs-test classification). Without it, the app falls back to the basic
# regex parser automatically — nothing breaks, results are just rougher.
# Get a key at https://console.anthropic.com → API Keys, and add billing.
# ANTHROPIC_API_KEY=sk-ant-...
# SYLLABUS_MODEL=claude-sonnet-5   # optional: claude-haiku-4-5 (cheaper) | claude-opus-5 (max)
# SCHEDULE_MODEL=claude-sonnet-5   # optional: model used for the AI Study Plan feature

# --- Google Calendar (optional) ---
# Lets the AI Study Plan see your existing calendar commitments so it doesn't
# recommend study sessions on top of them. Without these, the "Connect" button
# in Study Plan just doesn't appear — nothing else is affected.
# From https://console.cloud.google.com → APIs & Services → Credentials:
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# Must exactly match a redirect URI registered on that OAuth client.
# GOOGLE_REDIRECT_URI=http://localhost:3011/api/google/callback
# In dev only, so the OAuth callback can send the browser back to Vite
# (in production the client and API share one origin, so leave this unset).
# CLIENT_URL=http://localhost:5173

# --- Database ---
# Only needed in production (hosted deployment). Leave unset for local dev —
# the app falls back to a local SQLite file at server/data/planner.db.
# TURSO_DATABASE_URL=libsql://your-db-name-yourname.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
