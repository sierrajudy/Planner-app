PORT=3001

# --- AI syllabus reader (optional but recommended) ---
# With a key set, uploaded syllabi are parsed by Claude (clean dates, titles, and
# assignment-vs-test classification). Without it, the app falls back to the basic
# regex parser automatically — nothing breaks, results are just rougher.
# Get a key at https://console.anthropic.com → API Keys, and add billing.
# ANTHROPIC_API_KEY=sk-ant-...
# SYLLABUS_MODEL=claude-sonnet-5   # optional: claude-haiku-4-5 (cheaper) | claude-opus-5 (max)

# --- Database ---
# Only needed in production (hosted deployment). Leave unset for local dev —
# the app falls back to a local SQLite file at server/data/planner.db.
# TURSO_DATABASE_URL=libsql://your-db-name-yourname.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
